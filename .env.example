# mock runs without a key. Use BSTOM_MODE=compatible for the selected live provider.
BSTOM_MODE=mock
LLM_PROVIDER=gemini
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta
LLM_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
# Only used when LLM_PROVIDER=compatible (OpenAI-compatible providers).
LLM_API_KEY=
# Shared across sessions. Zero disables proactive RPM/TPM pacing and the call budget.
API_MAX_CONCURRENCY=4
API_REQUESTS_PER_MINUTE=0
API_TOKENS_PER_MINUTE=0
SESSION_MAX_CALLS=0
SESSION_MAX_MESSAGES=40
SESSION_MAX_SECONDS=900
MAX_SPEECH_CHARS=360
MAX_OUTPUT_TOKENS=512
REEVALUATE_SECONDS=12
SPEECH_COOLDOWN=0
# Complete messages appear at once; a reading gap separates chat bubbles.
# Adds up to 0.5 seconds based on previous message length; 0 disables the gap.
TURN_PAUSE_SECONDS=1
MOCK_CHUNK_DELAY=0.08

# Native desktop defaults override provider/limits without requiring a key.
# Optional local web config: LLM_PROVIDER=ollama, LLM_BASE_URL=http://127.0.0.1:11434,
# LLM_MODEL=gemma3:4b, API_MAX_CONCURRENCY=1.
OLLAMA_CONTEXT_LENGTH=2048
OLLAMA_FAST_MODE=true
# -1 lets Ollama choose GPU layers; 0 uses CPU; 99 requests all layers for small models.
OLLAMA_GPU_LAYERS=-1
